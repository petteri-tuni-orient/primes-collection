[Unit]
Description=Primes Node.js Application (Orientation to ICT 2026)
After=network.target

[Service]
Type=simple
User=labsvc
WorkingDirectory=/opt/orient26/primes-collection/nodejs
ExecStart=/usr/bin/node server.js
Restart=on-failure
Environment=NODE_ENV=production
Environment=PORT=8061

[Install]
WantedBy=multi-user.target


